+        if kind in ("cancel", "pause", "resume"):
+            return actions + self._voice_mission_command(kind, now, nav_ready)
+        # 짧은 답(affirm/deny)은 어느 질문의 답인지 상태가 정한다. CONFIRMING 이면 확인
